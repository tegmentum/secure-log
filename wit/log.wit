// Pluggable secure logging contract for the TPM operator platform.
//
// Two pluggability axes:
//
//   1. `encoder`  -- serializes log entries and checkpoints to canonical
//                    bytes. Different encodings (CBOR, protobuf, custom)
//                    satisfy the same interface. The encoding name is
//                    recorded alongside each entry so verifiers can pick
//                    the correct decoder.
//
//   2. `log`      -- the full logging subsystem: append, read, segment
//                    closure, chain/inclusion/checkpoint verification.
//                    Different storage backends (native SQLite, an
//                    append-only file, a remote service, an external
//                    WASM component) satisfy the same interface.
//
// The hash algorithm (SHA-256) and the canonical "chain hash" formula
// are frozen per-version: changing them is a world version bump.
//
// The native Rust implementation in crates/tpm-core/src/secure_log/
// mirrors this WIT verbatim as Rust traits. A WASM component
// implementing `secure-log-host` can replace either piece at runtime.

package secure-log:log@0.1.0;

// ---------------------------------------------------------------------
// Structured error surface.
//
// Every function on `log`, `encoder`, `checkpoint` returns
// `result<T, log-error>`. The variant mirrors the Rust
// `secure_log::SecureLogError` enum 1:1 so downstream consumers can
// pattern-match on structured errors instead of substring-matching on
// bare-string diagnostics. `chain-broken` and `inclusion-mismatch` carry
// their multi-field payloads via record types (WIT variant arms hold at
// most one payload) so field names + types remain self-documenting.
// ---------------------------------------------------------------------
interface types {
    // Payload for `log-error::chain-broken`. Names the seqno where the
    // chain link failed and a human-readable reason for the break.
    record chain-broken-detail {
        seqno:  u64,
        reason: string,
    }

    // Payload for `log-error::inclusion-mismatch`. Names the seqno whose
    // proof failed to reconstruct the expected Merkle root, and the
    // segment id the proof targeted.
    record inclusion-mismatch-detail {
        seqno:      u64,
        segment-id: u64,
    }

    // Structured error surface returned by every secure-log:log method.
    // Mirrors `secure_log::SecureLogError` in the Rust core crate.
    variant log-error {
        // No entry exists at the given seqno.
        entry-not-found(u64),
        // The named stream does not exist in the backing store.
        stream-not-found(string),
        // A hash-chain link failed to verify. See detail for the seqno
        // and reason.
        chain-broken(chain-broken-detail),
        // An inclusion proof did not reconstruct the expected root. See
        // detail for the offending seqno and segment id.
        inclusion-mismatch(inclusion-mismatch-detail),
        // No segment exists at the given segment id.
        segment-not-found(u64),
        // The named segment is already closed; re-close is rejected.
        segment-already-closed(u64),
        // `close-segment` refused because nothing has been appended
        // since the previous close for the named stream.
        empty-segment(string),
        // The operation is not implemented in this backend.
        not-implemented,
        // The underlying storage layer surfaced a diagnostic.
        storage(string),
        // The canonical encoder surfaced a diagnostic.
        encoding(string),
        // Caller-side input was malformed (bad severity, wrong hash
        // length, unknown tier, ...).
        invalid(string),
    }
}

// ---------------------------------------------------------------------
// Pluggable canonical encoder.
// ---------------------------------------------------------------------
interface encoder {
    // Severity of a log entry, RFC 5424 / POSIX syslog ordering.
    // Lower ordinal = more urgent. Matches `wasmos:log/logger.severity`
    // so records that traverse both interfaces do not need remapping.
    //
    // This is the canonical severity type for the secure-log package;
    // `log.append` and `store.secure-log-row` reference it via `use`.
    enum severity {
        // 0 — system is unusable.
        emergency,
        // 1 — action must be taken immediately.
        alert,
        // 2 — critical conditions.
        critical,
        // 3 — error conditions.
        error,
        // 4 — warning conditions.
        warning,
        // 5 — normal but significant condition.
        notice,
        // 6 — informational.
        info,
        // 7 — debug-level messages.
        debug,
    }

    // Structural representation of a log entry passed to the encoder.
    //
    // `prev-entry-hash` is 32 zero bytes for the genesis entry of a
    // stream. The encoder treats this as an opaque byte string and
    // must not interpret it.
    record entry-fields {
        version:          u32,
        stream-id:        string,
        session-id:       string,
        boot-id:          string,
        seqno:            u64,
        timestamp-rfc3339: string,
        event-type:       string,
        severity:         severity,
        producer:         string,
        payload-encoding: string,
        payload:          list<u8>,
        prev-entry-hash:  list<u8>,
    }

    // Structural representation of a segment checkpoint.
    record checkpoint-fields {
        version:              u32,
        stream-id:            string,
        segment-id:           u64,
        seq-start:            u64,
        seq-end:              u64,
        merkle-root:          list<u8>,
        last-entry-hash:      list<u8>,
        prev-checkpoint-hash: list<u8>,
        boot-id:              string,
        session-id:           string,
        policy-hash:          list<u8>,
        timestamp-rfc3339:    string,
    }

    // Encode an entry. The output is the exact byte sequence that will
    // be hashed and stored. The encoding MUST be deterministic: two
    // calls with identical inputs MUST produce identical bytes.
    encode-entry: func(fields: entry-fields) -> list<u8>;

    // Encode a checkpoint. Same determinism requirement.
    encode-checkpoint: func(fields: checkpoint-fields) -> list<u8>;

    // Stable identifier for this encoder, stored in each entry's
    // `payload-encoding` field so verifiers can pick the right decoder.
    // Examples: "cbor", "cbor+aead-chacha20poly1305", "protobuf".
    name: func() -> string;
}

// ---------------------------------------------------------------------
// Pluggable secure log backend.
// ---------------------------------------------------------------------
interface log {
    use encoder.{entry-fields, checkpoint-fields, severity};
    use types.{log-error};

    // Open / configure the backing store. MUST be called once before
    // any other method. `config` is forwarded verbatim to the store
    // backend (see `store.init` for the per-backend format). There is
    // no implicit default — an empty config is an error.
    open: func(config: string) -> result<_, log-error>;

    // Metadata describing a successfully appended entry.
    record append-result {
        seqno:      u64,
        entry-hash: list<u8>,
    }

    // Public projection of a stream's metadata, returned by
    // `list-streams`. Callers isolate live vs archived streams by
    // filtering on `deprecated-at.is-some`.
    //
    // Fields:
    //   name          — the stream identifier, as passed to `append`.
    //   tier          — confidentiality tier as a stable string
    //                   (`"public"`, `"protected"`, or
    //                   `"highly-restricted"`).
    //   description   — free-form human note captured at
    //                   `create-stream` time, if any.
    //   deprecated-at — unix seconds when the stream was deprecated,
    //                   or none for live streams.
    record stream-info {
        name:          string,
        tier:          string,
        description:   option<string>,
        deprecated-at: option<u64>,
    }

    // A closed segment with a Merkle root over its entries.
    record segment-info {
        segment-id:           u64,
        stream-id:            string,
        seq-start:            u64,
        seq-end:              u64,
        merkle-root:          list<u8>,
        last-entry-hash:      list<u8>,
        prev-checkpoint-hash: list<u8>,
        closed-at-rfc3339:    string,
        signature:            option<list<u8>>,
        signer-identity:      option<string>,
    }

    // Merkle inclusion proof for a single entry.
    record inclusion-proof {
        seqno:       u64,
        entry-hash:  list<u8>,
        segment-id:  u64,
        merkle-root: list<u8>,
        // Sibling hashes bottom-up, paired with a bit indicating which
        // side the sibling was on (false = left, true = right sibling).
        path:        list<proof-step>,
    }

    record proof-step {
        sibling-hash: list<u8>,
        right:        bool,
    }

    // Append a new entry to the given stream. Backends compute the
    // seqno, prev_entry_hash, and entry_hash; the caller only supplies
    // the event metadata and payload bytes.
    append: func(
        stream-id:    string,
        event-type:   string,
        severity:     severity,
        producer:     string,
        payload:      list<u8>,
    ) -> result<append-result, log-error>;

    // Append with an explicit `payload-encoding` override — the
    // stamped tag lands verbatim in the sealed row (and is hashed
    // into the chain), instead of the default value derived from
    // the backend's canonical encoder identity.
    //
    // Consumers that layer their own on-payload encoding (e.g.
    // `wasmos:audit@0.1.0/audit`, which wraps events in the ADR-0016
    // `wasmos-audit-cbor-v1` envelope before appending) pass the
    // wire tag here so verifiers can dispatch decoding on the
    // right schema — the on-disk canonical-encoder identity stays
    // whatever the backend picked (typically `"cbor"`).
    //
    // Backends that predate this method can preserve source
    // compatibility by treating the call as an `append` and
    // ignoring `payload-encoding`; the Rust trait's default impl
    // does exactly that.
    append-with-encoding: func(
        stream-id:        string,
        event-type:       string,
        severity:         severity,
        producer:         string,
        payload:          list<u8>,
        payload-encoding: string,
    ) -> result<append-result, log-error>;

    // Read a single entry by sequence number.
    read: func(seqno: u64) -> result<entry-fields, log-error>;

    // Return the highest seqno in the given stream, or none if empty.
    head: func(stream-id: string) -> result<option<u64>, log-error>;

    // Walk the hash chain between two sequence numbers (inclusive) and
    // verify every link. Returns ok(_) if the chain is intact, err(_)
    // with a diagnostic if any link is broken.
    verify-chain: func(
        stream-id:  string,
        from-seqno: u64,
        to-seqno:   u64,
    ) -> result<_, log-error>;

    // Close the current open segment for the given stream, building
    // the Merkle root over all entries since the last close.
    close-segment: func(stream-id: string) -> result<segment-info, log-error>;

    // List all closed segments for the given stream.
    list-segments: func(stream-id: string) -> list<segment-info>;

    // Read a single segment by id.
    read-segment: func(segment-id: u64) -> result<segment-info, log-error>;

    // Build an inclusion proof for a seqno in its segment's Merkle tree.
    build-inclusion-proof: func(seqno: u64) -> result<inclusion-proof, log-error>;

    // Verify a standalone inclusion proof against an expected root.
    verify-inclusion-proof: func(
        proof:         inclusion-proof,
        expected-root: list<u8>,
    ) -> result<_, log-error>;

    // Create or update a stream's metadata (tier + description).
    //
    // Streams also come into existence lazily on first `append`; the
    // row created that way defaults to `tier = "public"`. Explicit
    // `create-stream` lets an operator pin a tier BEFORE any appends
    // land — required for Phase-5 AEAD derivation because a
    // mid-stream tier flip would silently invalidate every prior
    // entry's decrypt key (the KDF label is different for
    // `highly-restricted` vs `public`).
    //
    // Idempotent: a second call with the same (`tier`, `description`)
    // is a no-op on the resulting state. Backends that don't track
    // stream metadata return `err("stream lifecycle not supported")`.
    create-stream: func(
        stream-id:   string,
        tier:        string,
        description: option<string>,
    ) -> result<_, log-error>;

    // Enumerate every stream known to the backend, including
    // deprecated ones. Callers isolate live vs archived by filtering
    // on `deprecated-at.is-some`.
    //
    // Order is backend-defined; the canonical native impl returns
    // rows in the order the store returns them (typically creation
    // order for the SQLite backend). Backends that don't track
    // streams return the empty list — safest fallback so callers can
    // treat "no streams" and "stream tracking unsupported"
    // identically.
    list-streams: func() -> result<list<stream-info>, log-error>;

    // Soft-delete a stream: subsequent `append` calls against it are
    // rejected with `err("stream '...' is deprecated ...")`. Existing
    // entries remain readable and the hash chain is unchanged, so
    // verification and inclusion proofs continue to work; only new
    // appends are blocked.
    //
    // The deprecation timestamp is stamped by the backend at call
    // time. Backends that don't track stream metadata return
    // `err("stream lifecycle not supported")`.
    deprecate-stream: func(stream-id: string) -> result<_, log-error>;
}

// ---------------------------------------------------------------------
// Pluggable checkpoint signing (Phase 3).
//
// Signing is in-graph: the core component imports a keystore (see
// `keys:keystore/signer`) and exposes these operations. The signing key
// never crosses the component boundary; verification dispatches on the
// key's algorithm (ed25519 / ecdsa-p256 / rsa-pss-sha256) using the
// public key the keystore exposes. This interface carries no external
// dependency, so storage providers that only reference the package are
// unaffected.
// ---------------------------------------------------------------------
interface checkpoint {
    use types.{log-error};

    // Sign the checkpoint of a closed segment using the keystore key
    // bound to `identity`, and persist the signature on the segment.
    // Returns (checkpoint-hash, signature).
    sign-segment: func(identity: string, segment-id: u64)
        -> result<tuple<list<u8>, list<u8>>, log-error>;

    // Verify one closed segment's stored signature against its
    // recomputed checkpoint hash. Returns the checkpoint hash.
    verify-segment-signature: func(segment-id: u64) -> result<list<u8>, log-error>;

    // Verify a stream's whole checkpoint chain from genesis to head.
    // Returns the number of signed segments walked.
    verify-checkpoint-chain: func(stream-id: string) -> result<u32, log-error>;
}

// ---------------------------------------------------------------------
// Host world. A WASM component implementing these interfaces is a
// drop-in replacement for the native Rust backend.
// ---------------------------------------------------------------------
world secure-log-host {
    export types;
    export encoder;
    export log;
    export checkpoint;
}
